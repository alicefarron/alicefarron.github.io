---
import { type Sprite, spriteColorVar, toRects } from "../lib/sprite";

interface Props {
	sprite: Sprite;
	scale?: number;
	title?: string;
	class?: string;
}

const { sprite, scale = 3, title, class: className } = Astro.props;
const rects = toRects(sprite);
const decorative = title === undefined;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox={`0 0 ${sprite.width} ${sprite.height}`}
	width={sprite.width * scale}
	height={sprite.height * scale}
	shape-rendering="crispEdges"
	focusable="false"
	class={className}
	aria-hidden={decorative ? "true" : undefined}
	role={decorative ? undefined : "img"}
>
	{title !== undefined && <title>{title}</title>}
	{rects.map((rect) => <rect x={rect.x} y={rect.y} width={rect.w} height={rect.h} fill={spriteColorVar(rect.color)} />)}
</svg>
