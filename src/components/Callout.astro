---
interface Props {
	label?: string;
	class?: string;
}

const { label = "Note", class: className } = Astro.props;
---

<aside
	class:list={[
		"border-window my-8 flex gap-4 bg-white p-4 shadow-hard-sm shadow-ink",
		className,
	]}
>
	<span
		aria-hidden="true"
		class="border-window flex size-9 shrink-0 items-center justify-center bg-yellow font-display text-ui-lg font-bold"
	>!</span>
	<div class="min-w-0 grow">
		<span class="sr-only">{label}</span>
		<slot />
	</div>
</aside>
