---
import { buttondownAction, site } from "../lib/site";
import { speechBubble } from "../sprites";
import PixelSprite from "./PixelSprite.astro";
import Window from "./Window.astro";

interface Props {
	variant?: "dialog" | "band";
	id?: string | null;
	class?: string;
}

const { variant = "band", id = "subscribe", class: className } = Astro.props;
const anchor = id ?? undefined;
const inputId = `${id ?? "subscribe-band"}-email`;
const heading = "Get the digest by email";
const lede = `One issue every ${site.digestDay}. ${site.taglineHighlight}`;
const button =
	"border-window inline-flex min-h-11 items-center justify-center rounded-dialog-button px-5 font-ui text-ui font-bold text-ink no-underline";
---

{
	variant === "dialog" ? (
		<div id={anchor} class:list={["scroll-mt-20", className]} data-subscribe data-variant="dialog">
		<Window title="subscribe" as="section" id={`${inputId}-dialog`} variant="alert" shadow="lg">
			<form
				method="post"
				action={buttondownAction()}
				target="_blank"
				class="flex flex-col gap-5"
			>
				<div class="flex items-start gap-4">
					<PixelSprite sprite={speechBubble} scale={4} class="shrink-0" />
					<div class="flex min-w-0 flex-col gap-2">
						<p class="font-ui text-ui-lg leading-ui font-bold">{heading}</p>
						<p class="font-ui text-ui leading-ui">{lede}</p>
					</div>
				</div>
				<div class="flex flex-col gap-2">
					<label for={inputId} class="font-label text-label">
						Email address
					</label>
					<input
						id={inputId}
						type="email"
						name="email"
						required
						autocomplete="email"
						inputmode="email"
						class="border-window min-h-11 w-full bg-white px-3 font-ui text-ui text-ink"
					/>
					<input type="hidden" name="embed" value="1" />
				</div>
				<div class="flex flex-wrap items-center justify-end gap-4">
					<a href="#main" data-not-now class:list={[button, "bg-white font-normal"]}>
						Not now
					</a>
					<button type="submit" class:list={[button, "ring-default m-1.5 bg-white"]}>
						Subscribe
					</button>
				</div>
			</form>
		</Window>
		</div>
	) : (
		<section
			id={anchor}
			aria-labelledby={`${inputId}-heading`}
			class:list={["bg-dots-sky scroll-mt-20 px-4 py-12", className]}
			data-subscribe
			data-variant="band"
		>
			<div class="border-window mx-auto flex max-w-3xl flex-col gap-4 bg-white p-6 shadow-hard-md shadow-ink">
				<h2 id={`${inputId}-heading`} class="font-display text-h3 leading-display font-bold uppercase">
					{heading}
				</h2>
				<p class="font-ui text-ui leading-ui">{lede}</p>
				<form
					method="post"
					action={buttondownAction()}
					target="_blank"
					class="flex flex-col gap-2"
				>
					<label for={inputId} class="font-label text-label">
						Email address
					</label>
					<div class="flex flex-col gap-3 dock:flex-row">
						<input
							id={inputId}
							type="email"
							name="email"
							required
							autocomplete="email"
							inputmode="email"
							class="border-window min-h-11 w-full min-w-0 grow bg-white px-3 font-ui text-ui text-ink"
						/>
						<input type="hidden" name="embed" value="1" />
						<button type="submit" class:list={[button, "bg-yellow shadow-hard-sm shadow-ink"]}>
							Subscribe
						</button>
					</div>
				</form>
			</div>
		</section>
	)
}
