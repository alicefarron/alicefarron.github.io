---
import PetButton from "../islands/PetButton";
import { petLines } from "../lib/pet";
import { cat } from "../sprites";
import PixelSprite from "./PixelSprite.astro";
import Window from "./Window.astro";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<Window title="meow.app" class={className} data-window="meow" bodyClass="flex flex-col items-center justify-center gap-4 p-6">
	<PixelSprite sprite={cat} scale={6} />
	<PetButton client:visible lines={petLines} />
</Window>
