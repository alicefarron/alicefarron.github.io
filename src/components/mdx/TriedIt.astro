---
import { triedItId, triedItTitle } from "../../lib/digest";
import Terminal from "../Terminal.astro";

interface Props {
	command?: string;
	label?: string;
}

const { command, label = "terminal" } = Astro.props;
---

<section aria-labelledby={triedItId} class="counter-section mt-12 flex scroll-mt-20 flex-col gap-6">
	<div class="flex items-center gap-3">
		<span
			aria-hidden="true"
			class="section-number border-window flex size-10 shrink-0 items-center justify-center bg-lime font-display text-ui-lg font-bold text-ink shadow-hard-sm shadow-ink"
		></span>
		<h2 id={triedItId} class="scroll-mt-20 font-display text-h2 leading-display font-bold uppercase">{triedItTitle}</h2>
	</div>
	<div class="flex flex-col gap-4 font-body text-body leading-body" data-tried-it>
		<slot />
		{
			command !== undefined && (
				<Terminal label={label}>
					<pre class="overflow-x-auto"><code>{`$ ${command}`}</code></pre>
				</Terminal>
			)
		}
	</div>
</section>
