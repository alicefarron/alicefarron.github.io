---
export type ItemSource = {
	name: string;
	url: string;
};

interface Props {
	headline: string;
	source: ItemSource;
	takeaway?: string;
}

const { headline, source, takeaway } = Astro.props;
---

<article class="border-window bg-white p-4 shadow-hard-sm shadow-ink">
	<h3 class="font-ui text-ui-lg leading-ui font-bold">{headline}</h3>
	<div class="mt-3 bg-yellow px-3 py-2 font-body text-body leading-body wrap-anywhere" data-takeaway>
		{takeaway !== undefined ? <p>{takeaway}</p> : <slot />}
	</div>
	<p class="mt-3 font-label text-label-sm uppercase">
		Source:{" "}
		<a href={source.url} class="text-ink underline wrap-anywhere">{source.name}</a>
	</p>
</article>
