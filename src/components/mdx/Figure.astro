---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	caption?: string;
	src?: ImageMetadata;
	alt?: string;
	class?: string;
}

const { caption, src, alt, class: className } = Astro.props;
---

<figure class:list={["my-8 flex flex-col gap-2", className]}>
	<div class="border-window overflow-hidden bg-white shadow-hard-sm shadow-ink">
		{src !== undefined ? <Image src={src} alt={alt ?? ""} class="block h-auto w-full" /> : <slot />}
	</div>
	{caption !== undefined && <figcaption class="font-ui text-ui-sm leading-ui">{caption}</figcaption>}
</figure>
