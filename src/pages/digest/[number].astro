---
import { render } from "astro:content";
import Footer from "../../components/Footer.astro";
import PixelStairs from "../../components/PixelStairs.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import TagChip from "../../components/TagChip.astro";
import Window from "../../components/Window.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	entryReadingTime,
	getPublishedIssues,
	type Issue,
} from "../../lib/collections";
import { issuePath, prevIssue } from "../../lib/content";
import { issueContents } from "../../lib/digest";
import {
	formatDate,
	isoDate,
	issueLabel,
	minutesLabel,
} from "../../lib/format";
import { topicColor } from "../../lib/labels";
import { digestComponents } from "../../lib/mdx-components";

export async function getStaticPaths() {
	const issues = await getPublishedIssues();
	return issues.map((issue) => ({
		params: { number: String(issue.data.number).padStart(3, "0") },
		props: { issue, previous: prevIssue(issues, issue.data.number) },
	}));
}

interface Props {
	issue: Issue;
	previous?: Issue;
}

const { issue, previous } = Astro.props;
const { Content } = await render(issue);
const contents = issueContents(issue.body ?? "");
const label = issueLabel(issue.data.number);
const quote = issue.data.quote;
---

<BaseLayout
	title={`${label}: ${issue.data.title}`}
	description={issue.data.lede}
	type="article"
	hasSubscribeForm
	preloadBody
>
	<div class="bg-dots-sky">
		<header class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-4 pt-10 pb-12">
			<p class="flex flex-wrap items-center gap-x-2 bg-ink px-3 py-1.5 font-label text-label text-white" data-issue-chip>
				<span>Issue {label}</span>
				<span aria-hidden="true">·</span>
				<time datetime={isoDate(issue.data.date)}>{formatDate(issue.data.date)}</time>
				<span aria-hidden="true">·</span>
				<span>{minutesLabel(entryReadingTime(issue))}</span>
			</p>
			<h1 class="font-display text-h1 leading-display font-bold uppercase">This week in AI</h1>
			<div class="border-window max-w-3xl -rotate-1 bg-white p-5 shadow-hard-md shadow-ink">
				<p class="font-display text-h3 leading-display font-semibold">
					<mark class="bg-yellow px-1 text-ink" data-issue-title>{issue.data.title}</mark>
				</p>
				<p class="mt-3 font-ui text-ui leading-ui">{issue.data.lede}</p>
			</div>
			<ul class="flex flex-wrap gap-2" aria-label="Topics">
				{issue.data.topics.map((topic) => <li><TagChip label={topic} color={topicColor(topic)} /></li>)}
			</ul>
			{
				contents.length > 0 && (
					<Window title="contents" as="nav" class="w-full max-w-xl" data-window="contents" bodyClass="p-4">
						<ol class="counter-sections flex flex-col gap-2 font-ui text-ui leading-ui">
							{contents.map((entry) => (
								<li class="counter-section flex items-baseline gap-3">
									<span aria-hidden="true" class="section-number font-label text-label-sm" />
									<a href={`#${entry.id}`} class="text-ink underline">{entry.title}</a>
								</li>
							))}
						</ol>
					</Window>
				)
			}
		</header>
		<PixelStairs from="sky" to="paper" />
	</div>

	<article class="bg-paper">
		<div class="counter-sections mx-auto flex max-w-3xl flex-col gap-4 px-4 py-12 font-body text-body leading-body" data-issue-body>
			<Content components={digestComponents} />
		</div>

		{
			quote !== undefined && (
				<div class="mx-auto max-w-3xl px-4 pb-12">
					<Window title="quote.txt" as="aside" variant="yellow" shadow="lg" data-window="quote" bodyClass="p-6">
						<figure class="flex flex-col gap-4">
							<blockquote class="font-display text-h3 leading-display font-semibold">
								<p>"{quote.text}"</p>
							</blockquote>
							<figcaption class="font-ui text-ui">
								{quote.author}, {quote.role}
							</figcaption>
						</figure>
					</Window>
				</div>
			)
		}

		<nav aria-label="Issues" class="mx-auto flex max-w-3xl flex-wrap justify-between gap-4 px-4 pb-16 font-ui text-ui">
			{
				previous !== undefined ? (
					<a
						href={issuePath(previous.data.number)}
						rel="prev"
						class="border-window inline-flex min-h-11 items-center bg-white px-4 text-ink no-underline shadow-hard-sm shadow-ink"
						data-previous
					>
						← previous: {issueLabel(previous.data.number)}
					</a>
				) : (
					<span />
				)
			}
			<a
				href="/digest"
				class="border-window inline-flex min-h-11 items-center bg-white px-4 text-ink no-underline shadow-hard-sm shadow-ink"
			>
				archive/
			</a>
		</nav>
	</article>

	<SubscribeForm variant="band" />
	<Footer slot="footer" />
</BaseLayout>
