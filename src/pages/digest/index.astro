---
import Footer from "../../components/Footer.astro";
import PixelStairs from "../../components/PixelStairs.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import Window from "../../components/Window.astro";
import FilterList from "../../islands/FilterList";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedIssues } from "../../lib/collections";
import { issueEntry } from "../../lib/entries";
import { digestTopics } from "../../lib/schemas";

const issues = (await getPublishedIssues()).map(issueEntry);
---

<BaseLayout
	title="Digest archive"
	description="Every issue of This week in AI, newest first, filterable by topic."
	hasSubscribeForm
>
	<div class="bg-dots-sky">
		<div class="mx-auto flex max-w-5xl flex-col gap-8 px-4 pt-10 pb-12">
			<h1 class="font-display text-h1 leading-display font-bold uppercase">Archive/</h1>
			<Window title="archive/" as="section" shadow="lg" class="w-full" data-window="archive">
				<FilterList client:idle kind="issue" items={issues} filters={digestTopics} groupLabel="Filter by topic" />
			</Window>
		</div>
		<PixelStairs from="sky" to="paper" />
	</div>
	<SubscribeForm variant="band" />
	<Footer slot="footer" />
</BaseLayout>
